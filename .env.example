# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional, but 60 requests/hour without it vs 5000 with it.
# A classic token with no scopes is enough for public repositories.
GITHUB_TOKEN=

# Project settings -> Database -> Connection string -> Session pooler.
# Used only by scripts/run-sql.mjs to run migrations and drills.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
